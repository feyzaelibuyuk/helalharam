<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="helalharam.MainPage"
             BackgroundColor="#F8F8F4"
             Title="helalmi?">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="22,14" ColumnDefinitions="*,Auto" BackgroundColor="#F8F8F4">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" BackgroundColor="#1E4B3D" StrokeShape="RoundRectangle 11">
                    <Label Text="H" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Text="helalmi?" TextColor="#20312C" FontSize="21" FontAttributes="Bold" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <Border Grid.Column="1" Padding="10,6" Stroke="#CFDDD3" StrokeThickness="1" BackgroundColor="#F0F5EF" StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                <Label Text="BETA · TÜRKİYE" FontSize="9" TextColor="#557667" FontAttributes="Bold" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="22,24,22,30" Spacing="18">
                <Label Text="BİLGİLİ SEÇİM, İÇİN RAHATLIĞI" FontSize="10" CharacterSpacing="1.4" TextColor="#71867B" FontAttributes="Bold" />
                <Label Text="Ne yediğini&#10;bilerek seç." FontSize="38" LineHeight="1.05" TextColor="#1D342C" FontAttributes="Bold" />
                <Label Text="Ürün içeriğini incele, restoran yemekleri hakkında sorulacakları öğren." FontSize="14" TextColor="#68766F" LineHeight="1.5" />

                <Border Padding="12,4" BackgroundColor="White" Stroke="#DFE3DC" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="SearchEntry" Placeholder="Ürün, marka veya içerik ara..." TextColor="#273C34" PlaceholderColor="#A2AAA4" ClearButtonVisibility="WhileEditing" Completed="OnSearchCompleted" />
                        <Button Grid.Column="1" Text="Ara  →" BackgroundColor="#245342" TextColor="White" CornerRadius="7" Padding="16,0" Clicked="OnSearchClicked" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="ProductsButton" Text="Paketli ürünler" BackgroundColor="#245342" TextColor="White" CornerRadius="8" FontSize="12" Clicked="OnProductsClicked" />
                    <Button x:Name="RestaurantsButton" Grid.Column="1" Text="Restoran yemekleri" BackgroundColor="#EEEFEB" TextColor="#6F7D74" CornerRadius="8" FontSize="12" Clicked="OnRestaurantsClicked" />
                </Grid>
                <Label x:Name="ResultCount" Text="Kaynak durumuyla gösterilen örnek kayıtlar" FontSize="11" TextColor="#8A948D" />

                <CollectionView x:Name="ResultsList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="16" BackgroundColor="White" Stroke="#E7E9E3" StrokeThickness="1" StrokeShape="RoundRectangle 11">
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Status}" TextColor="#9B6C37" BackgroundColor="#FBF2E5" Padding="8,5" FontSize="10" HorizontalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding Subtitle}" TextColor="#98A19B" FontSize="10" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Label Text="{Binding Title}" TextColor="#2D4037" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Details}" TextColor="#79847D" FontSize="12" LineHeight="1.4" />
                                    <Label Text="{Binding Note}" TextColor="#7A6952" FontSize="11" LineHeight="1.35" />
                                    <Label Text="{Binding Source}" TextColor="#89948C" FontSize="10" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border Padding="14" BackgroundColor="#FBF7EE" Stroke="#EBDFCB" StrokeThickness="1" StrokeShape="RoundRectangle 9">
                    <Label Text="Bilgi notu — Uygulama kesin dini hüküm veya sertifika vermez. Örnek kayıtlar gösterim amaçlıdır; gerçek ürün/işletme bilgisi olarak kullanılmamalıdır." FontSize="11" TextColor="#927950" LineHeight="1.4" />
                </Border>
                <Label x:Name="ConnectionStatus" Text="" FontSize="10" TextColor="#9A6C36" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
