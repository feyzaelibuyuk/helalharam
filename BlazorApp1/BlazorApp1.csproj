<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>helalharam-web-feyza-admin-v1</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup><Compile Include="..\Shared\FavoriteList.cs" Link="Shared\FavoriteList.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\helalharam\MenuQuestions.cs" Link="Shared\MenuQuestions.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\Shared\CorrectionInput.cs" Link="Shared\CorrectionInput.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\Shared\PrivacyNotice.cs" Link="Shared\PrivacyNotice.cs" /></ItemGroup>
  <ItemGroup>
    <Content Update="Data/certificates.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="keys/**;helalharam.db*;.verification/**" />
    <None Remove="keys/**;helalharam.db*;.verification/**" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\Shared\FeedbackInput.cs" Link="Shared\FeedbackInput.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\Shared\UiCatalog.cs" Link="Shared\UiCatalog.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\Shared\TranslationInput.cs" Link="Shared\TranslationInput.cs" /></ItemGroup>
<ItemGroup><Compile Include="..\helalharam\QuestionCards.cs" Link="Shared/QuestionCards.cs" /></ItemGroup>
</Project>
