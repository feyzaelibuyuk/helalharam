@page "/feedback"
@using HelalRehber.Shared
@using BlazorApp1.Services
@inject FeedbackService Feedbacks
<PageTitle>@Ui.T("feedback") | Helal mi?</PageTitle>
<main class="app-shell">
<header class="topbar"><a class="brand" href="/">@Ui.T("backCatalog")</a><a href="/privacy">@Ui.T("privacy")</a></header>
<h1>@Ui.T("feedbackHeading")</h1>
<p>@Ui.T("feedbackPrompt")</p><p>@Ui.T("feedbackPrivacy")</p>
@if (receipt is not null) {
    <div role="status"><h2>@Ui.T("feedbackSaved")</h2><p>Gönderim: @receipt</p><a href="/feedback" data-enhance-nav="false">@Ui.T("newFeedback")</a></div>
} else {
    @foreach (var error in errors) { <p role="alert">@error</p> }
    <EditForm Model="Input" OnSubmit="Submit" FormName="feedback">
        <input type="hidden" name="Input.SubmissionId" value="@Input!.SubmissionId" />
        <label for="feedback-kind">@Ui.T("category")</label>
        <InputSelect id="feedback-kind" @bind-Value="Input.Category"><option value="">@Ui.T("choose")</option>@foreach(var category in FeedbackRules.Categories){<option value="@category.Id">@Ui.T(category.Id)</option>}</InputSelect>
        <label for="feedback-message">@Ui.T("description")</label>
        <InputTextArea id="feedback-message" @bind-Value="Input.Message" rows="6" maxlength="2000" style="width:100%" />
        <button type="submit" class="search-button">@Ui.T("feedbackSend")</button>
    </EditForm>
}
</main>
@code {
    [SupplyParameterFromForm] public FeedbackInput? Input { get; set; }
    private List<string> errors = [];
    private Guid? receipt;
    protected override void OnInitialized() { Input ??= new() { SubmissionId = Guid.NewGuid() }; Input.Client = "web"; Input.Version = "0.1"; }
    private async Task Submit()
    {
        if (Input is null) return;
        errors = FeedbackRules.Validate(Input); if (errors.Count > 0) return;
        try { var result = await Feedbacks.SubmitAsync(Input); if (result.Receipt is not null) receipt = result.Receipt; else errors = [result.Message]; }
        catch (Exception) { errors = ["Sonuç alınamadı. Metniniz korunuyor; aynı gönderimi tekrar deneyin."]; }
    }
}
