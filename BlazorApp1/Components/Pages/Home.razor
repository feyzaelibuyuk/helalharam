@page "/"
@rendermode InteractiveServer
@using BlazorApp1.Data
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject ProductCatalog Catalog
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Helal mi? | Ürün ve yemek bilgisi</PageTitle>

<main class="app-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Helal mi ana sayfa"><span class="brand-mark">H</span><span>helal<span class="brand-dot">mi?</span></span></a>
        <a href="/favorites" data-enhance-nav="false">Favorilerim ☆</a><span class="beta-pill">BETA · ÜRÜN KATALOĞU</span>
    </header>

    <section class="hero">
        <div class="eyebrow"><span class="eyebrow-dot"></span> BİLGİLİ SEÇİM, İÇİN RAHATLIĞI</div>
        <h1>Ne yediğini<br /><span>bilerek seç.</span></h1>
        <p>Ürün içeriğini incele, restoran yemekleri hakkında sorulacakları öğren. Her bilgi için kaynağı ve belirsizliği açıkça gösteriyoruz.</p>
        <form method="get" action="/">
        <div class="search-box">
            <span class="search-icon">⌕</span>
            <input name="q" aria-label="Ürün veya içerik ara" @bind="query" @bind:event="oninput" placeholder="Ürün, marka veya içerik ara..." />
            <button class="search-button" type="submit">Ara <span>→</span></button>
        </div>
        <div class="quick-links"><label>Satış ülkesi kodu <input name="country" aria-label="Satış ülkesi kodu" @bind="country" maxlength="2" placeholder="TR, DE…; boşsa tümü" /></label></div></form><div class="quick-links"><span>Popüler aramalar:</span><button @onclick='() => QuickSearch("jelatin")'>jelatin</button><button @onclick='() => QuickSearch("E471")'>E471</button><button @onclick='() => QuickSearch("aroma verici")'>aroma verici</button></div>
    </section>

    <section class="catalog-section">
        <h2>Gerçek barkod sorgula</h2><p><a href="/ingredients">İçindekiler metnini elle değerlendir →</a></p>
        <p class="ingredients">Marka, ambalaj fotoğrafı ve içerikler Open Food Facts'ten alınır. Aşağıdaki yerel katalog demo kayıtlarını içerir.</p>
        <form method="get" action="/off" class="search-box">
            <input name="barcode" aria-label="Gerçek ürün barkodu" inputmode="numeric" maxlength="14" placeholder="Ambalaj barkodu; örnek: 3017620422003" />
            <button type="submit" class="search-button">Barkodu sorgula →</button>
        </form>
    </section>
    <section class="catalog-section">
        <div class="section-heading">
            <div><div class="section-kicker">KEŞFET</div><h2>Bilgiye göz at</h2></div>
            <div class="tabs" role="tablist"><button class="@(showProducts ? "active" : "")" @onclick="ShowProducts">Paketli ürünler</button><button class="@(!showProducts ? "active" : "")" @onclick="ShowRestaurants">Restoran yemekleri</button></div>
        </div>

        @if (showProducts)
        {
            @if (searchError is not null) { <div class="empty-state" role="alert">@searchError</div> }
            <div class="results-label">@products.Count ürün kaydı <span>·</span> Bilgiler kaynak durumuyla gösterilir</div>
            <div class="card-grid">
                @foreach (var product in products)
                {
                    <article class="info-card">
                        <div class="card-top"><div class="product-icon">@(product.Name.StartsWith("Örnek Sütlü") ? "▧" : product.Name.StartsWith("Örnek Çilek") ? "◉" : "◇")</div><span class="status status-review">@product.Assessment</span></div>
                        <div class="product-brand">@product.Brand</div><h3>@product.Name</h3>
                        <p class="ingredients">@product.Ingredients</p>
                        <div class="card-note"><span>ⓘ</span> @product.Note</div>
                        <div class="card-source">KAYNAK DURUMU <strong>@product.Source</strong></div>
<div class="card-source">@product.Category · @(product.CountryCode == "" ? "Ülke belirtilmedi" : product.CountryCode) · @(product.IsDemo ? "DEMO" : "Katalog kaydı")</div><a href="@($"/products/{product.Id}")">Detay ve alternatifler →</a>
                    </article>
                }
            </div>
            @if (products.Count == 0) { <div class="empty-state">Bu aramayla eşleşen kayıt yok. Ülke filtresini kontrol edin. Barkod bulunamazsa içindekiler metnini kullanın; kamera ve OCR sonraki sürümde eklenecek.</div> }
        }
        else
        {
            <div class="results-label">@restaurants.Count yemek kaydı <span>·</span> İşletme bilgileri henüz doğrulanmadı</div>
            <div class="card-grid">
                @foreach (var restaurant in restaurants)
                {
                    <article class="info-card restaurant-card">
                        <div class="card-top"><div class="product-icon restaurant-icon">⌂</div><span class="status status-review">İşletmeye danışın</span></div>
                        <div class="product-brand">@restaurant.Name</div><h3>@restaurant.Dish</h3>
                        <p class="ingredients">@restaurant.PossibleIngredients</p>
                        <div class="card-note"><span>?</span> Sorulabilecekler: @restaurant.Questions</div>
                        <div class="card-source">BİLGİ KAYNAĞI <strong>@restaurant.InformationSource</strong></div>
                    </article>
                }
            </div>
            @if (restaurants.Count == 0) { <div class="empty-state">Bu aramayla eşleşen yemek kaydı yok.</div> }
        }
    </section>

    <footer class="disclaimer"><span>ⓘ</span><p><strong>Bilgi notu</strong> — Bu uygulama kesin dini hüküm veya sertifika vermez. Örnek kayıtlar gösterim amaçlıdır; gerçek ürün ya da işletme bilgisi olarak kullanılmamalıdır. Paketli ürünlerde şüpheli içerik ve eksik bilgi uyarılarını inceleyin. Restoran ve açık yemeklerde içerik ve hazırlama bilgisi için işletmeye danışın.</p></footer>
    <footer class="site-footer"><span>helalmi? <span class="brand-dot">·</span> Kaynağıyla bilgi</span><span>İçerik ve değerlendirmeler bilgilendirme amaçlıdır.</span></footer>
</main>

@code {
    private List<ProductRecord> products = [];
    private string country = "";
    private string? searchError;
    private List<Restaurant> restaurants = [];
    private string query = "";
    private bool showProducts = true;

    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public string? CountryQuery { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        query = SearchQuery ?? "";
        country = CountryQuery ?? "";
        await Search();
    }

    private async Task Search()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var term = query.Trim();
        searchError = ProductCatalog.ValidCountry(country) ? null : "Ülke için iki harfli kod kullanın (TR, DE gibi).";
        products = searchError is null ? await Catalog.SearchAsync(term, country) : [];
        restaurants = await db.Restaurants.AsNoTracking()
            .Where(r => term == "" || r.Name.Contains(term) || r.Dish.Contains(term) || r.PossibleIngredients.Contains(term))
            .OrderBy(r => r.Name).ToListAsync();
    }

    private async Task QuickSearch(string term) { query = term; showProducts = true; await Search(); }
    private async Task ShowProducts() { showProducts = true; await Search(); }
    private async Task ShowRestaurants() { showProducts = false; await Search(); }
}
