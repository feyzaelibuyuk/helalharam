@page "/"
@rendermode InteractiveServer
@using BlazorApp1.Data
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject ProductCatalog Catalog
@using Microsoft.EntityFrameworkCore
@inject RestaurantCatalog Restaurants

<PageTitle>Helal mi? | Ürün ve yemek bilgisi</PageTitle>

<main class="app-shell">
    <header class="topbar">
        <a dir="ltr" class="brand" href="/" aria-label="Helal mi ana sayfa"><span class="brand-mark">H</span><span>helal<span class="brand-dot">mi?</span></span></a>
        <a href="/travel" data-enhance-nav="false">Harita ve seyahat</a>
        <a href="/questions" data-enhance-nav="false">Çok dilli soru kartları</a>
        <a href="/favorites" data-enhance-nav="false">@Ui.T("myFavorites")</a><span class="beta-pill">@Ui.T("catalogBadge")</span>
    </header>

    <section class="hero">
        <div class="eyebrow"><span class="eyebrow-dot"></span> @Ui.T("eyebrow")</div>
        <h1>@Ui.T("heroFirst")<br /><span>@Ui.T("heroSecond")</span></h1>
        <p>@Ui.T("heroDescription")</p>
        <form method="get" action="/">
        <div class="search-box">
            <span class="search-icon">⌕</span>
            <input name="q" aria-label="@Ui.T("searchLabel")" @bind="query" @bind:event="oninput" placeholder="@Ui.T("searchPlaceholder")" />
            <button class="search-button" type="submit">@Ui.T("search") <span>→</span></button>
        </div>
        <input type="hidden" name="mode" value="@(showProducts ? "products" : "restaurants")" />
        @if (showProducts) {
            <div class="quick-links"><label>@Ui.T("country") <input dir="ltr" name="country" aria-label="@Ui.T("country")" @bind="country" maxlength="2" placeholder="@Ui.T("countryHint")" /></label></div>
        }
        else {
            <div class="quick-links"><label for="restaurant-city">@Ui.T("city")</label><input id="restaurant-city" name="city" @bind="city" placeholder="@Ui.T("cityHint")" maxlength="80" /></div>
        }
</form><div class="quick-links"><span>@Ui.T("popular")</span><button @onclick='() => QuickSearch("jelatin")'>@Ui.T("gelatin")</button><button @onclick='() => QuickSearch("E471")'>E471</button><button @onclick='() => QuickSearch("aroma verici")'>@Ui.T("flavour")</button></div>
    </section>

    <section class="catalog-section">
        <h2>@Ui.T("realBarcode")</h2><p><a href="/ingredients">@Ui.T("manualIngredients")</a></p>
        <p class="ingredients">@Ui.T("offDescription")</p>
        <form method="get" action="/off" class="search-box">
            <input dir="ltr" name="barcode" aria-label="@Ui.T("sourceBarcodeAria")" inputmode="numeric" maxlength="14" placeholder="@Ui.T("barcodeHint")" />
            <button type="submit" class="search-button">@Ui.T("lookupBarcode")</button>
        </form>
    </section>
    <section class="catalog-section">
        <div class="section-heading">
            <div><div class="section-kicker">@Ui.T("explore")</div><h2>@Ui.T("browse")</h2></div>
            <div class="tabs" role="tablist"><button class="@(showProducts ? "active" : "")" @onclick="ShowProducts">@Ui.T("packaged")</button><button class="@(!showProducts ? "active" : "")" @onclick="ShowRestaurants">@Ui.T("restaurantDishes")</button></div>
        </div>

        @if (showProducts)
        {
            @if (searchError is not null) { <div class="empty-state" role="alert">@searchError</div> }
            <div class="results-label">@Ui.F("productCount", products.Count)</div>
            <div class="card-grid">
                @foreach (var product in products)
                {
                    <article class="info-card">
                        <div class="card-top"><div class="product-icon">@(product.Name.StartsWith("Örnek Sütlü") ? "▧" : product.Name.StartsWith("Örnek Çilek") ? "◉" : "◇")</div><span class="status status-review">@product.Assessment</span></div>
                        <div class="product-brand">@product.Brand</div><h3 dir="auto">@product.Name</h3>
                        <p dir="auto" class="ingredients">@product.Ingredients</p>
                        <div class="card-note"><span>ⓘ</span> @product.Note</div>
                        <div class="card-source">@Ui.T("sourceStatus") <strong dir="auto">@product.Source</strong></div>
<div class="card-source">@product.Category · @(product.CountryCode == "" ? Ui.T("countryUnspecified") : product.CountryCode) · @(product.IsDemo ? "DEMO" : Ui.T("catalogRecord"))</div><a href="@($"/products/{product.Id}")">@Ui.T("details")</a>
                    </article>
                }
            </div>
            @if (products.Count == 0) { <div class="empty-state">@Ui.T("emptyProducts")</div> }
        }
        else
        {
            <div class="results-label">@Ui.F("dishCount", restaurants.Count)</div>
            <div class="card-grid">
                @foreach (var restaurant in restaurants)
                {
                    <article class="info-card restaurant-card">
                        <div class="card-top"><div class="product-icon restaurant-icon">⌂</div><span class="status status-review">@Ui.T("askBusiness")</span></div>
                        <div class="product-brand">@restaurant.Name</div><h3 dir="auto">@restaurant.Dish</h3><p class="ingredients">@(restaurant.IsDemo ? Ui.T("demoBusiness") : Ui.T("sourceUnverified")) · @(restaurant.City.Length == 0 ? Ui.T("cityUnspecified") : restaurant.City) · @restaurant.Branch</p>
                        <p class="ingredients">@restaurant.PossibleIngredients</p>
                        <div class="card-note"><span>?</span> @Ui.T("questions") @restaurant.Questions</div>
                        <div class="card-source">@Ui.T("source") <strong>@restaurant.InformationSource</strong></div><a href="@($"/restaurants/{restaurant.Id}")">@Ui.T("dishDetails")</a>
                    </article>
                }
            </div>
            @if (restaurants.Count == 0) { <div class="empty-state">@Ui.T("noDishes")</div> }
        }
    </section>

    <footer class="disclaimer"><span>ⓘ</span><p><strong>@Ui.T("infoNote")</strong> — @Ui.T("homeDisclaimer")</p></footer>
    <footer class="site-footer"><span>helalmi? <span class="brand-dot">·</span> @Ui.T("withSources")</span><span>@Ui.T("footer")</span></footer>
</main>

@code {
    private List<ProductRecord> products = [];
    private string country = "";
    private string? searchError;
    private List<RestaurantRecord> restaurants = [];
    private string city = "";
    private string query = "";
    private bool showProducts = true;

    [SupplyParameterFromQuery(Name = "city")] public string? CityQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "country")] public string? CountryQuery { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        query = SearchQuery ?? "";
        city = CityQuery ?? ""; showProducts = ModeQuery != "restaurants";
        country = CountryQuery ?? "";
        await Search();
    }

    private async Task Search()
    {

        var term = query.Trim();
        searchError = !showProducts || ProductCatalog.ValidCountry(country) ? null : "Ülke için iki harfli kod kullanın (TR, DE gibi).";
        products = searchError is null ? await Catalog.SearchAsync(term, country) : [];
        restaurants = await Restaurants.SearchAsync(term, city);
    }

    private async Task QuickSearch(string term) { query = term; showProducts = true; await Search(); }
    private async Task ShowProducts() { showProducts = true; await Search(); }
    private async Task ShowRestaurants() { showProducts = false; await Search(); }
}
