@page "/translate"
@page "/translate/off/{Barcode}"
@page "/translate/catalog/{CatalogId:int}"
@inject TranslationService Translator
@inject OpenFoodFactsCatalog Products
@inject ProductCatalog LocalProducts
<PageTitle>Etiket / menü çevirisi | Helal mi?</PageTitle>
<main class="app-shell">
<header class="topbar"><a href="/">← Katalog</a></header>
<h1>Etiketin veya menünün tamamını çevir</h1>
@if(CatalogId is not null){<p>Metin yerel ürün kaydından aktarılır; demo veya eksik kayıt olabilir. Özgün etiketle karşılaştırın. <a href="@($"/products/{CatalogId}")" data-enhance-nav="false">Ürün kaydına dön →</a></p>}
<p>Barkod bulunmasa da metinle çalışır. İçindekiler, alerjen / eser miktar uyarıları, besin değerleri ve diğer açıklamalar dahil çevirmek istediğiniz tüm metni girin. Yalnız girilen metin çevrilir; okunmayan bölümler tamamlanmış sayılmaz.</p>
@if(options is null || options.Message.Length>0){<p role="status">@(options?.Message ?? "Dil listesi yüklenemedi.")</p>}
@foreach(var error in errors){<p role="alert">@error</p>}
<EditForm Model="Input" OnSubmit="Submit" FormName="translation">
<label for="translate-mode">Metin türü</label><InputSelect id="translate-mode" @bind-Value="Input!.Mode"><option value="label">Paketin arka yüzü / etiket</option><option value="menu">Restoran menüsü</option></InputSelect>
<label for="translation-text">Özgün metnin tamamı (en fazla 12.000 karakter)</label>
<InputTextArea id="translation-text" dir="auto" @bind-Value="Input!.Text" rows="10" style="width:100%" />
<label for="source-language">Kaynak dil</label><InputSelect id="source-language" @bind-Value="Input.SourceLanguage"><option value="auto">Otomatik algıla — sonucu kontrol edin</option>@foreach(var lang in options?.Languages ?? []){<option value="@lang.Code">@lang.NativeName (@lang.Code)</option>}</InputSelect>
<label for="target-language">Çeviri dili</label><InputSelect id="target-language" @bind-Value="Input.TargetLanguage"><option value="">Dil seçin</option>@foreach(var lang in options?.Languages ?? []){<option value="@lang.Code">@lang.NativeName (@lang.Code)</option>}</InputSelect>
<p><label><InputCheckbox @bind-Value="Input.ReviewedSource" /> Metni özgün etiket / menü ile karşılaştırıp düzelttim. Eksik veya okunmayan bölümleri ayrıca kontrol edeceğim.</label></p>
<p><label><InputCheckbox @bind-Value="Input.CloudConsent" /> Bu metnin çeviri için sunucunun bilgisayarındaki yerel LibreTranslate servisine gönderilmesini onaylıyorum. Fotoğraf gönderilmez. Gerekirse ön kontrol için ek İngilizce çeviri kullanılır; karakter kotasına dahildir. Kişisel / sağlık bilgisi yazmayacağım.</label></p>
<button type="submit" class="search-button" disabled="@(options?.Configured != true || options.Languages.Count==0)">Metnin tamamını çevir</button>
</EditForm>
@if(document is not null){
<section class="catalog-section"><h2>Çeviri sonucu · @document.Provider</h2><p>Kaynak: @document.SourceLanguage → Hedef: @document.TargetLanguage</p>
@foreach(var warning in document.Warnings){<p role="note">@warning</p>}
<div class="translation-columns"><article class="info-card"><h3>Özgün metin</h3><p dir="auto" style="white-space:pre-wrap">@document.OriginalText</p></article><article class="info-card"><h3>Makine çevirisi</h3><p dir="@document.Direction" style="white-space:pre-wrap">@document.TranslatedText</p></article></div>
<h3>Özgün metin: kişisel filtreler</h3><BlazorApp1.Components.Shared.FoodPreferencePanel Text="@document.OriginalText" Language="@document.SourceLanguage"/>
<h3>Çeviri: kişisel filtreler — makine çevirisi hatalı olabilir</h3><BlazorApp1.Components.Shared.FoodPreferencePanel Text="@document.TranslatedText" Language="@document.TargetLanguage"/>
@if(document.OriginalAssessment is { } source){<h3>Özgün metin değerlendirmesi</h3><p>@source.Status · @source.Summary</p>@foreach(var finding in source.Findings){<article class="info-card"><h4>@finding.Ingredient · @finding.MatchedText</h4><p>@finding.Reason</p><a href="@finding.SourceUrl" target="_blank" rel="noopener noreferrer">@finding.SourceTitle</a></article>}}
@if(document.TranslationPrecheck is { } check){
<h3>Makine çevirisi üzerinde ön kontrol — ürün onayı değildir</h3><p>@check.Summary</p>
@if(document.PrecheckLanguage != document.TargetLanguage){<details><summary>Ön kontrolde kullanılan ek metin (@document.PrecheckLanguage)</summary><p dir="ltr" style="white-space:pre-wrap">@document.PrecheckText</p></details>}
@foreach(var severity in new[]{"restricted","uncertain"}){
<h4>@(severity=="restricted" ? "Çeviride kısıtlı madde eşleşmeleri" : "Çeviride şüpheli / kaynağı belirsiz eşleşmeler")</h4>
var findings=check.Findings.Where(x=>x.Severity==severity).ToList();
@if(findings.Count==0){<p>Bu sınırlı kurallarda eşleşme yok. Helal veya alerjen güvenliği onayı değildir.</p>}
@foreach(var finding in findings){<article class="info-card"><h4>@finding.Ingredient · @finding.MatchedText</h4><p>@finding.Reason</p><a href="@finding.SourceUrl" target="_blank" rel="noopener noreferrer">@finding.SourceTitle</a></article>}
}
}
@if(document.Mode=="menu"){<p>Menü çevirisi gerçek tarif, et kaynağı veya hazırlama yöntemini doğrulamaz. İçerik ve ortak ekipman için işletmeye sorun.</p>}
<p>Alerjen yokluğu veya helal sertifikası bu ekrandan doğrulanmaz.</p></section>
}
</main>
@code {
    [SupplyParameterFromQuery(Name="target")] public string? Target { get; set; }
    [Parameter] public string? Barcode { get; set; }
    [Parameter] public int? CatalogId { get; set; }
    [SupplyParameterFromForm] public TranslationInput? Input { get; set; }
    private TranslationOptions? options;
    private TranslationDocument? document;
    private List<string> errors=[];
    protected override async Task OnInitializedAsync()
    {
        var fresh=Input is null; Input ??= new() { TargetLanguage=Target??Ui.Language };
        options=await Translator.OptionsAsync();
        if(fresh && Target is not null && !options.Languages.Any(x=>x.Code==Target)) errors.Add("Seyahat için seçilen hedef dilin çeviri modeli yüklü değil. Çeviri dilini mevcut listeden seçin.");
        if(fresh && CatalogId is { } id){
            var detail=await LocalProducts.GetDetailAsync(id);
            if(detail is not null){var product=detail.Product;Input.Text=string.IsNullOrWhiteSpace(product.OriginalIngredients)?product.Ingredients:product.OriginalIngredients;Input.SourceLanguage=string.IsNullOrWhiteSpace(product.IngredientsLanguage)?"auto":product.IngredientsLanguage;if(!options.Languages.Any(x=>x.Code==Input.SourceLanguage))Input.SourceLanguage="auto";}
            else errors.Add("Yerel ürün bulunamadı. Etiket metnini elle girebilirsiniz.");
        }
        if(fresh && Barcode is not null){ var result=await Products.FindAsync(Barcode); if(result.Product is { } product){Input.Text=product.Ingredients;Input.SourceLanguage=product.IngredientsLanguage=="zh-Hans" ? "zh" : product.IngredientsLanguage;if(!options.Languages.Any(x=>x.Code==Input.SourceLanguage))Input.SourceLanguage="auto";}else errors=["Ürün bulunamadı. Etiket metnini elle girin veya mobil OCR kullanın."]; }
    }
    private async Task Submit()
    {
        if(Input is null)return;
        var result=await Translator.TranslateAsync(Input); document=result.Document;
        errors=result.HttpStatus==200 ? [] : [result.Message];
    }
}
