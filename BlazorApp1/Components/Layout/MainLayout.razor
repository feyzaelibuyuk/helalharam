@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <BlazorApp1.Components.Shared.LanguagePicker />
            <a href="/certificates">Sertifika kaynakları</a>
            <a href="/travel" data-enhance-nav="false">Harita ve seyahat</a>
            <a href="/questions" data-enhance-nav="false">Çok dilli soru kartları</a>
            <a href="/translate">Etiket / menü çevirisi</a>
            <a href="/feedback">@Ui.T("feedback")</a>
            <a href="/privacy">@Ui.T("privacy")</a>
        </div>

        <article class="content px-4">
            @if(Ui.Language != "tr") { <aside class="translation-scope" role="note">@Ui.T("scope") <strong>@Ui.T("limits")</strong></aside> }
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu. Sayfayı yenileyip tekrar deneyin. Öneri gönderdiyseniz yeniden göndermeden önce sonucunu kontrol edin.
    <a href="." class="reload">@Ui.T("reload")</a>
    <span class="dismiss">🗙</span>
</div>
